{ Delphi 2007 through Delphi 13 Florence. Minor updates share CompilerVersion. }
{ Version reference: https://docwiki.embarcadero.com/RADStudio/Florence/en/Compiler_Versions }
{ SC_DELPHI10 is the legacy Delphi 2006 symbol; SC_DELPHI10_0 is Delphi 10 Seattle. }
{ Exact symbols identify a release; _UP includes it and later releases, }
{ _EARLY means earlier releases, and _AND_EARLY includes the named release. }

{$IFDEF CONDITIONALEXPRESSIONS} { Delphi 6 and later support CompilerVersion }
  {$IF CompilerVersion >= 18.5}
    {$DEFINE SC_DELPHI2_UP}
    {$DEFINE SC_DELPHI3_UP}
    {$DEFINE SC_DELPHI4_UP}
    {$DEFINE SC_DELPHI5_UP}
    {$DEFINE SC_DELPHI6_UP}
    {$DEFINE SC_DELPHI7_UP}
    {$DEFINE SC_DELPHI8_UP}
    {$DEFINE SC_DELPHI9_UP}
    {$DEFINE SC_DELPHI10_UP}
    {$IFDEF BCB}
      {$DEFINE SC_CBUILDER}
      {$ObjExportAll On}
    {$ENDIF}
  {$IFEND}
{$ENDIF}

